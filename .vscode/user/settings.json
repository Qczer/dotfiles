  "editor.fontLigatures": true,
  "editor.wordWrap": "on",
  "accessibility.signals.chatResponseReceived": {
    "sound": "off",
  },
  "editor.accessibilitySupport": "off",
  "workbench.browser.openLocalhostLinks": false,
  "redhat.telemetry.enabled": false,
  "workbench.openInAgents.enabled": false,
  "workbench.browser.showInTitleBar": false,
  "prettier.jsxSingleQuote": true,
  "prettier.semi": false,
  "scm.repositories.selectionMode": "single",
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://biomejs.dev": true,
  },
  "window.menuBarVisibility": "compact",
  "workbench.navigationControl.enabled": false,
  "chat.tips.enabled": false,
  "chat.agentsControl.enabled": "hidden",
  "chat.viewSessions.enabled": false,
  "less.format.enable": false,
  "biome.runFromTemporaryLocation": false,
  "terminal.integrated.hideOnStartup": "always",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "smooth",
  "terminal.integrated.cursorBlinking": true,
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  "editor.linkedEditing": true,
  "vim.leader": " ",
  "vim.useSystemClipboard": true,
  "vim.visualModeKeyBindings": [
    {
      "before": [">"],
      "commands": ["editor.action.indentLines"],
    },
    {
      "before": ["<"],
      "commands": ["editor.action.outdentLines"],
    },
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    // Moving cursor
    {
      "before": ["J"],
      "after": ["5", "j"],
    },
    {
      "before": ["K"],
      "after": ["5", "k"],
    },
    {
      "before": ["<Leader>", "j"],
      "after": ["J"],
    },
    {
      "before": ["<Leader>", "k"],
      "after": ["K"],
    },

    // Center cursor on command
    {
      "before": ["<C-d>"],
      "after": ["<C-d>", "z", "z"],
    },
    {
      "before": ["<C-u>"],
      "after": ["<C-u>", "z", "z"],
    },
    {
      "before": ["<C-f>"],
      "after": ["<C-f>", "z", "z"],
    },
    {
      "before": ["<C-b>"],
      "after": ["<C-b>", "z", "z"],
    },
    {
      "before": ["n"],
      "after": ["n", "z", "z", "z", "v"],
    },
    {
      "before": ["N"],
      "after": ["N", "z", "z", "z", "v"],
    },

    // Splits
    {
      "before": ["<C-h>"],
      "after": ["<C-w>", "h"],
    },
    {
      "before": ["<C-j>"],
      "after": ["<C-w>", "j"],
    },
    {
      "before": ["<C-k>"],
      "after": ["<C-w>", "k"],
    },
    {
      "before": ["<C-l>"],
      "after": ["<C-w>", "l"],
    },

    // Commands
    {
      "before": ["<leader>", "p"],
      "commands": ["workbench.action.showCommands"],
    },
    {
      "before": ["<leader>", "o"],
      "commands": ["workbench.action.quickOpen"],
    },
    {
      "before": ["leader", "t"],
      "commands": ["workbench.action.gotoSymbol"],
    },

    // Tabs
    {
      "before": ["<Leader>", "t", "t"],
      "commands": [":tabnew"],
    },
    {
      "before": ["<Leader>", "t", "n"],
      "commands": [":tabnext"],
    },
    {
      "before": ["<Leader>", "t", "p"],
      "commands": [":tabprev"],
    },
    {
      "before": ["<Leader>", "t", "o"],
      "commands": [":tabo"],
    },
    {
      "before": ["<Leader>", "t", "c"],
      "commands": [":tabclose"],
    },

    // No highlight on search
    {
      "before": ["<Leader>", "/"],
      "commands": [":noh"],
    },
  ],
  "vim.insertModeKeyBindingsNonRecursive": [
    {
      "before": ["j", "j"],
      "after": ["<ESC>"],
    },
    {
      "before": ["j", "k"],
      "after": ["<ESC>"],
    },
  ],
  "editor.lineNumbers": "relative",
  "prettify-ts.enabled": false,
  "prettier.enableDebugLogs": true,
  "editor.detectIndentation": false,
  "git.confirmSync": false,
  "vim.sneak": true,
  "vim.easymotion": true,
  "vim.enableNeovim": true,
  "vim.gdefault": true,
  "vim.highlightedyank.enable": true,
  "geminicodeassist.inlineSuggestions.enableAuto": false,
  "diffEditor.codeLens": true,
  "workbench.settings.applyToAllProfiles": ["vim.useCtrlKeys"],
  "vim.camelCaseMotion.enable": true,
  "vim.neovimPath": "C:\\Program Files\\Neovim\\bin\\nvim.exe",
}
